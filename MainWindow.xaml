<Window x:Class="RpVoiceSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RpVoiceSwitcher"
        Title="RP Voice Switcher" Width="780" Height="820" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" Language="de-DE"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" PreviewMouseDown="Window_PreviewMouseDown">
    <DockPanel>
        <!-- ===== Menüleiste (Alt oder F10 öffnet sie) ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Command="{x:Static local:AppCommands.NewVoice}"/>
                <MenuItem Command="{x:Static local:AppCommands.ImportVoice}"/>
                <MenuItem Command="{x:Static local:AppCommands.ExportVoices}"/>
                <MenuItem Command="{x:Static local:AppCommands.AddSounds}"/>
                <Separator/>
                <MenuItem Header="Stimmen-_Ordner öffnen" Click="OpenFolder_Click"/>
                <MenuItem Header="Sound-O_rdner öffnen" Click="OpenSoundFolder_Click"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.CloseWindow}" Header="Fenster _schließen (läuft im Tray weiter)"/>
                <MenuItem Command="{x:Static local:AppCommands.Exit}"/>
            </MenuItem>
            <MenuItem x:Name="CharacterMenu" Header="_Charakter" SubmenuOpened="CharacterMenu_SubmenuOpened">
                <MenuItem Command="{x:Static local:AppCommands.NewProfile}"/>
                <MenuItem Command="{x:Static local:AppCommands.RenameProfile}"/>
                <MenuItem Command="{x:Static local:AppCommands.DeleteProfile}"/>
                <Separator/>
                <MenuItem x:Name="SelectVoicesMenuItem" Command="{x:Static local:AppCommands.SelectVoices}" IsCheckable="False"/>
                <MenuItem Command="{x:Static local:AppCommands.ResetHotkeys}"/>
                <Separator x:Name="CharacterListSeparator"/>
                <!-- Hier hängt die App die Charaktere zum Wechseln an -->
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_Ansicht" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem Command="{x:Static local:AppCommands.ShowVoices}"/>
                <MenuItem Command="{x:Static local:AppCommands.ShowSoundboard}"/>
                <Separator/>
                <MenuItem x:Name="StatusOverlayMenuItem" Header="Status-_Anzeige auf dem Bildschirm" IsCheckable="True" Click="StatusOverlayMenu_Click"/>
                <MenuItem x:Name="FlashMenuItem" Header="_Einblendung beim Wechsel" IsCheckable="True" Click="FlashMenu_Click"/>
                <MenuItem x:Name="BeepMenuItem" Header="_Ton beim Umschalten" IsCheckable="True" Click="BeepMenu_Click"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.Refresh}"/>
            </MenuItem>
            <MenuItem x:Name="ExtrasMenu" Header="E_xtras">
                <MenuItem Command="{x:Static local:AppCommands.ShowSetup}"/>
                <MenuItem Command="{x:Static local:AppCommands.SetupWizard}"/>
                <MenuItem Command="{x:Static local:AppCommands.ShowSettings}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.VoiceTest}"/>
                <MenuItem x:Name="PanicMenuItem" Command="{x:Static local:AppCommands.Panic}"/>
                <MenuItem x:Name="PttLatchMenuItem" Command="{x:Static local:AppCommands.TogglePttLatch}" IsCheckable="False"/>
                <MenuItem Command="{x:Static local:AppCommands.StopSounds}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.OpenEditor}"/>
                <MenuItem Command="{x:Static local:AppCommands.OpenDeviceSelector}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.OpenRecording}"/>
                <MenuItem Command="{x:Static local:AppCommands.OpenPlayback}"/>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Command="{x:Static local:AppCommands.Help}"/>
                <MenuItem Command="{x:Static local:AppCommands.SetupWizard}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.ReportProblem}"/>
                <MenuItem Command="{x:Static local:AppCommands.CopyDiagnostics}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.WhatsNew}"/>
                <MenuItem Command="{x:Static local:AppCommands.CheckUpdates}"/>
                <MenuItem Command="{x:Static local:AppCommands.About}"/>
            </MenuItem>
        </Menu>

        <!-- ===== Statusleiste ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock>
                    <Hyperlink x:Name="SetupStatusLink" Click="SetupWarning_Click" ToolTip="Zum Tab „Einrichtung“">
                        <Run x:Name="SetupStatusText" Text="Einrichtung wird geprüft …"/>
                    </Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
            <StatusBarItem x:Name="UpdateStatusItem" DockPanel.Dock="Right" Visibility="Collapsed">
                <TextBlock>
                    <Hyperlink x:Name="UpdateStatusLink" Click="UpdateLink_Click" Foreground="{StaticResource Accent}">
                        <Run x:Name="UpdateStatusText" Text="Update verfügbar"/>
                    </Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <Separator x:Name="UpdateStatusSeparator" DockPanel.Dock="Right" Visibility="Collapsed"/>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="SoundStatusText" ToolTip="Zustand des Soundboards"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FgDim}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== Charakter-Leiste ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,4">
            <DockPanel x:Name="ProfileBar">
                <TextBlock Text="Charakter:" Foreground="{StaticResource FgDim}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="+ Neu" Command="{x:Static local:AppCommands.NewProfile}" Padding="10,5" Margin="0,0,6,0" ToolTip="Neuen Charakter anlegen (Strg+Umschalt+N)"/>
                    <Button x:Name="RenameProfileButton" Content="Umbenennen" Command="{x:Static local:AppCommands.RenameProfile}" Padding="10,5" Margin="0,0,6,0" ToolTip="Charakter umbenennen (F2)"/>
                    <Button x:Name="DeleteProfileButton" Content="Löschen" Command="{x:Static local:AppCommands.DeleteProfile}" Padding="10,5"/>
                </StackPanel>
                <ItemsControl x:Name="ProfileList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding Name}" Click="ProfileChip_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- Inhalte der Fenster „Einrichtung“ und „Einstellungen“ (Menü Extras). Die App hängt sie beim Start in eigene Fenster um. -->
        <Grid x:Name="DetachedPanels" DockPanel.Dock="Top" Visibility="Collapsed">
                    <DockPanel x:Name="SetupPanel">
                        <Border DockPanel.Dock="Top" Padding="20,12,20,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Erneut prüfen" Click="RunSetupCheck_Click" Padding="12,5"/>
                                <Button DockPanel.Dock="Right" Content="Diagnose kopieren" Command="{x:Static local:AppCommands.CopyDiagnostics}" Padding="12,5" Margin="0,0,8,0"
                                        ToolTip="Alle Prüfergebnisse und Einstellungen als Text in die Zwischenablage – zum Weitergeben, wenn etwas nicht klappt"/>
                                <Button DockPanel.Dock="Right" Content="Schritt für Schritt …" Command="{x:Static local:AppCommands.SetupWizard}" Padding="12,5" Margin="0,0,8,0"
                                        ToolTip="Einrichtungs-Assistent: führt von null durch Downloads, Installation und Windows-Einstellungen"/>
                                <TextBlock x:Name="SetupSummary" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"
                                           Text="Prüft, ob die ganze Kette Mikrofon → Kabel → Equalizer APO → Spiel richtig eingerichtet ist."/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
                            <ItemsControl x:Name="CheckList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding IconBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{Binding FixLabel}" Visibility="{Binding FixVisibility}" Click="Fix_Click"
                                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    <!-- ===== Einstellungen: links Navigation, rechts Karten je Bereich ===== -->
                    <DockPanel x:Name="SettingsPanel">
                        <Border DockPanel.Dock="Left" Width="184" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                            <StackPanel x:Name="SettingsNav" Margin="10,14,10,10">
                                <TextBlock Text="EINSTELLUNGEN" Foreground="{StaticResource FgDim}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,10"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Allgemein" CommandParameter="SetGeneral" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Notfall-Taste" CommandParameter="SetPanic" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Sprachtaste im Spiel" CommandParameter="PttSection" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Status-Anzeige" CommandParameter="SetStatus" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Geräte" CommandParameter="SetDevices" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Ordner" CommandParameter="SetFolders" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Stream (OBS)" CommandParameter="SetObs" Click="SettingsNav_Click"/>
                                <Button Style="{StaticResource SettingsNavButton}" Content="Updates" CommandParameter="SetUpdates" Click="SettingsNav_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScroll_ScrollChanged" Focusable="False">
                            <StackPanel x:Name="SettingsCards" Margin="20,16,20,12" Grid.IsSharedSizeScope="True">

                                <!-- ===== Allgemein ===== -->
                                <Border x:Name="SetGeneral" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE713;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Allgemein" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Rückmeldung beim Umschalten und Verhalten des Fensters." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="SoundCheck" Content="Ton beim Umschalten" Click="Option_Changed" Margin="0,0,12,8"/>
                                            <CheckBox x:Name="OverlayCheck" Content="Einblendung beim Wechsel" Click="Option_Changed" Margin="0,0,12,8"/>
                                            <CheckBox x:Name="TrayCheck" Content="Schließen = in den Tray" Click="Option_Changed" Margin="0,0,12,0"
                                                      ToolTip="Das Fenster schließen lässt die App im Infobereich weiterlaufen – die Shortcuts bleiben aktiv."/>
                                            <CheckBox x:Name="AutostartCheck" Content="Mit Windows starten" Click="Autostart_Changed" Margin="0,0,12,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Notfall-Taste ===== -->
                                <Border x:Name="SetPanic" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Notfall-Taste" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Sofort zurück auf „Normal“, alle Sounds aus, Halten und Dauersenden beendet – in jedem Charakter." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Taste" Style="{StaticResource SettingsLabel}" Margin="0,0,14,0"/>
                                            <Button x:Name="PanicButton" Grid.Column="1" Content="Keine Taste" Click="PanicKey_Click" MinWidth="220" Padding="10,5" Margin="0,0,4,0"
                                                    AutomationProperties.Name="Notfall-Taste"
                                                    ToolTip="Klicken und Taste drücken. Entf = keine Notfall-Taste, Esc = abbrechen."/>
                                            <Button Grid.Column="2" Content="✕" Click="ClearPanicKey_Click" Padding="8,5" ToolTip="Notfall-Taste entfernen" AutomationProperties.Name="Notfall-Taste entfernen"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0" Text="Ideal: Pause, Rollen oder eine F-Taste – etwas, das du im Spiel nicht versehentlich drückst."/>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Sprachtaste im Spiel ===== -->
                                <Border x:Name="PttSection" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE720;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Sprachtaste im Spiel (Push-to-Talk)" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Style="{StaticResource SettingsSubtitle}"
                                                           Text="Für Spiele, die nur mit gedrückter Sprechtaste senden (z. B. nanos world). Die App kann die Taste nicht aus dem Spiel auslesen – stell dieselbe ein wie in den Sprachchat-Einstellungen des Spiels."/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Sprachtaste des Spiels" Style="{StaticResource SettingsLabel}"/>
                                            <Button x:Name="PttKeyButton" Grid.Column="1" Content="Taste wählen …" Click="PttKey_Click" MinWidth="220" Padding="10,5" Margin="0,0,4,8"
                                                    AutomationProperties.AutomationId="PttKeyButton"
                                                    ToolTip="Klicken und dann die Sprechtaste aus dem Spiel drücken – Taste oder Maus 4/5. Entf = keine, Esc = abbrechen."/>
                                            <Button Grid.Column="2" Content="✕" Click="ClearPttKey_Click" Padding="8,5" Margin="0,0,0,8"
                                                    ToolTip="Sprachtaste entfernen" AutomationProperties.Name="Sprachtaste entfernen"/>
                                            <TextBlock Grid.Row="1" Text="Dauersenden an/aus" Style="{StaticResource SettingsLabel}"/>
                                            <Button x:Name="PttLatchButton" Grid.Row="1" Grid.Column="1" Content="Keine Taste" Click="PttLatchKey_Click" MinWidth="220" Padding="10,5" Margin="0,0,4,8"
                                                    AutomationProperties.AutomationId="PttLatchButton"
                                                    ToolTip="Shortcut, mit dem du zwischen Dauersenden und Push-to-Talk umschaltest – gilt in allen Charakteren, auch im Spiel. Klicken und Kombination drücken; Entf = keine, Esc = abbrechen."/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="✕" Click="ClearPttLatchKey_Click" Padding="8,5" Margin="0,0,0,8"
                                                    ToolTip="Dauersenden-Taste entfernen" AutomationProperties.Name="Dauersenden-Taste entfernen"/>
                                        </Grid>
                                        <CheckBox x:Name="PttCheck" Content="Beim Abspielen von Sounds automatisch drücken" Click="PttCheck_Click" Margin="0,4,0,0"
                                                  ToolTip="Die App drückt die Sprachtaste kurz vor jedem Sound und lässt sie kurz danach wieder los – sonst hört im Spiel niemand den Sound."/>
                                        <TextBlock x:Name="PttHint" Foreground="#E5C07A" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                        <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                                                   Text="Dauersenden hält die Sprachtaste gedrückt, bis du es wieder ausschaltest – wie ein offenes Mikrofon. Drückst du die Sprachtaste zwischendurch selbst, läuft es einfach weiter. Als Umschalt-Taste eignet sich z. B. Strg + Alt + eine F-Taste."/>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Status-Anzeige ===== -->
                                <Border x:Name="SetStatus" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Status-Anzeige" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Kleines Fenster über dem Spiel mit Charakter, Stimme und laufenden Sounds (im Fenster- oder Randlos-Modus)." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="MoveStatusButton" Content="Position anpassen" Click="MoveStatus_Click" Padding="10,4" Margin="0,0,6,0"
                                                        ToolTip="Anzeige mit der Maus verschieben. Doppelklick auf die Anzeige oder 'Fertig' zum Speichern."/>
                                                <Button Content="Zurücksetzen" Click="ResetStatusPosition_Click" Padding="10,4" ToolTip="Position zurücksetzen"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StatusCheck" Content="Auf dem Bildschirm anzeigen" Click="StatusOverlay_Changed" VerticalAlignment="Center" Margin="0"
                                                      ToolTip="Zeigt dauerhaft an, welcher Charakter und welche Stimme aktiv ist"/>
                                        </DockPanel>
                                        <CheckBox x:Name="StatusHideNormalCheck" Content="Nur zeigen, wenn eine Effekt-Stimme aktiv ist (bei „Normal“ ausblenden)"
                                                  Click="StatusHideNormal_Changed" Margin="0,4,0,4"/>
                                        <CheckBox x:Name="StatusSoundsCheck" Content="Laufende Sounds mit Fortschritt und Zeit anzeigen"
                                                  Click="StatusSounds_Changed" Margin="0,2,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*" MaxWidth="320"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Größe" Style="{StaticResource SettingsLabel}"/>
                                            <Slider x:Name="StatusScaleSlider" Grid.Column="1" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" VerticalAlignment="Center" Margin="0,0,0,8"
                                                    AutomationProperties.Name="Größe der Status-Anzeige" ValueChanged="StatusLook_Changed"/>
                                            <TextBlock x:Name="StatusScaleText" Grid.Column="2" Text="100 %" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,8"/>
                                            <TextBlock Grid.Row="1" Text="Deckkraft" Style="{StaticResource SettingsLabel}" Margin="0,0,14,0"/>
                                            <Slider x:Name="StatusOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Deckkraft der Status-Anzeige" ValueChanged="StatusLook_Changed"/>
                                            <TextBlock x:Name="StatusOpacityText" Grid.Row="1" Grid.Column="2" Text="100 %" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Geräte ===== -->
                                <Border x:Name="SetDevices" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE7F5;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Geräte" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Über welche Geräte Stimme und Sounds zu den anderen gehen. Ob alles zusammenpasst, zeigt Extras → Einrichtung." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Stimmen wirken auf" Style="{StaticResource SettingsLabel}"/>
                                            <TextBox x:Name="DeviceBox" Grid.Column="1" Margin="0,0,0,8" LostFocus="DeviceBox_LostFocus"
                                                     ToolTip="Aufnahmegerät, auf das die Stimmen wirken (wie in Windows angezeigt), z. B. CABLE Output. Ein Teil des Namens reicht."/>
                                            <TextBlock Grid.Row="1" Text="Soundboard spielt auf" Style="{StaticResource SettingsLabel}"/>
                                            <TextBox x:Name="SoundDeviceBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" LostFocus="SoundDeviceBox_LostFocus"
                                                     ToolTip="Wiedergabegerät, das ins Mikrofon der anderen geht, z. B. CABLE Input. Ein Teil des Namens reicht."/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingsDivider}" Margin="0,6,0,12"/>
                                        <CheckBox x:Name="KeepDefaultMicCheck" Content="Kabel als Windows-Standardmikrofon halten" Click="KeepDefaultMic_Click" Margin="0"
                                                  AutomationProperties.AutomationId="KeepDefaultMicCheck"
                                                  ToolTip="Stellt ein anderes Programm (z. B. Shure MOTIV Mix, NVIDIA Broadcast) sein Mikrofon als Windows-Standard ein, setzt die App sofort wieder das Kabel. Wichtig für Spiele ohne eigene Mikrofon-Auswahl, z. B. Steam-Sprachchat / nanos world."/>
                                        <TextBlock Style="{StaticResource SettingsHint}" Margin="24,3,0,0"
                                                   Text="Für Spiele ohne eigene Mikrofon-Auswahl (z. B. Steam-Sprachchat, nanos world) – die nehmen einfach den Windows-Standard."/>
                                        <TextBlock x:Name="DefaultMicText" Style="{StaticResource SettingsHint}" Margin="24,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Ordner ===== -->
                                <Border x:Name="SetFolders" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Ordner" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Wo Stimmen und Sounds liegen. Beim Wechsel kannst du deine Dateien mitnehmen; gilt für alle Charaktere." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Stimmen" Style="{StaticResource SettingsLabel}" VerticalAlignment="Top" Margin="0,1,14,14"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                                <TextBlock x:Name="VoicesFolderText" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="VoicesFolderHint" Style="{StaticResource SettingsHint}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="Ändern …" Click="ChangeVoicesFolder_Click" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="Öffnen" Click="OpenFolder_Click" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="Standard" Click="ResetVoicesFolder_Click" Padding="10,3" ToolTip="Zurück zum Equalizer-APO-Ordner"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="Sounds" Style="{StaticResource SettingsLabel}" VerticalAlignment="Top" Margin="0,1,14,0"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock x:Name="SoundFolderText" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="SoundFolderHint" Style="{StaticResource SettingsHint}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="Ändern …" Click="ChangeSoundFolder_Click" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="Öffnen" Click="OpenSoundFolder_Click" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="Standard" Click="ResetSoundFolder_Click" Padding="10,3" ToolTip="Zurück zu Dokumente\RP Voice Switcher\Sounds"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Stream (OBS) ===== -->
                                <Border x:Name="SetObs" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE714;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Stream (OBS)" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock Text="Schreibt die aktive Stimme in eine Textdatei – in OBS als Quelle „Text (GDI+)“ → „Aus Datei lesen“ einbinden." Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <CheckBox x:Name="ObsCheck" Content="Aktive Stimme in eine Textdatei schreiben" Click="Obs_Changed" Margin="0,0,0,10"
                                                  ToolTip="In OBS: Quelle „Text (GDI+)“ → „Aus Datei lesen“ → diese Datei wählen"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Datei" Style="{StaticResource SettingsLabel}" VerticalAlignment="Top" Margin="0,1,14,12"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                                <TextBlock x:Name="ObsFileText" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="Ändern …" Click="ChangeObsFile_Click" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="Ordner öffnen" Click="OpenObsFolder_Click" Padding="10,3"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Text" Style="{StaticResource SettingsLabel}" VerticalAlignment="Top" Margin="0,4,14,0"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBox x:Name="ObsTemplateBox" LostFocus="ObsTemplate_LostFocus" AutomationProperties.Name="Text für OBS"/>
                                                <TextBlock x:Name="ObsPreviewText" Style="{StaticResource SettingsHint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,4,0,0"
                                                           Text="Platzhalter: {stimme}, {charakter} und {effekt} (wie {stimme}, aber leer bei „Normal“)."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ===== Updates ===== -->
                                <Border x:Name="SetUpdates" Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="&#xE895;" Style="{StaticResource SettingsIcon}" Width="28" DockPanel.Dock="Left"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Updates" Style="{StaticResource SettingsTitle}"/>
                                                <TextBlock x:Name="VersionText" Style="{StaticResource SettingsSubtitle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Was ist neu" Command="{x:Static local:AppCommands.WhatsNew}" Padding="10,4" Margin="0,0,6,0"/>
                                                <Button Content="Jetzt suchen" Command="{x:Static local:AppCommands.CheckUpdates}" Padding="10,4"/>
                                            </StackPanel>
                                            <CheckBox x:Name="UpdateCheck" Content="Beim Start nach Updates suchen" Click="UpdateCheck_Changed" VerticalAlignment="Center" Margin="0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
        </Grid>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- ===== Stimmen ===== -->
            <TabItem Header="Stimmen">
                <DockPanel AllowDrop="True" Drop="Voices_Drop" DragOver="Voices_DragOver" Background="Transparent">
                    <Border DockPanel.Dock="Top" Padding="20,12,20,6">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="+ Neue Stimme" Command="{x:Static local:AppCommands.NewVoice}" Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="Leere Stimme anlegen (Strg+N). Stimmen-Dateien (.txt) kannst du auch einfach hierher ziehen."/>
                                <Button x:Name="SelectVoicesButton" Content="Stimmen auswählen" Command="{x:Static local:AppCommands.SelectVoices}" Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="Festlegen, welche Stimmen zu diesem Charakter gehören"/>
                                <Button Content="Probehören" Command="{x:Static local:AppCommands.VoiceTest}" Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="Kurz sprechen und normal mit Effekt vergleichen (Strg+P)"/>
                                <Button Content="Shortcuts zurücksetzen" Command="{x:Static local:AppCommands.ResetHotkeys}" Padding="10,4" Margin="0,0,6,6"/>
                                <Button Content="EAPO-Editor" Click="OpenEditor_Click" Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="Equalizer-APO-Editor öffnen, z. B. um Graillon in eine Stimme einzubauen"/>
                            </WrapPanel>
                            <TextBlock x:Name="VoiceHint" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Umschalten = einmal drücken. Halten = nur solange die Taste gedrückt ist."/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
                        <ItemsControl x:Name="VoiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource Card}" CornerRadius="8" Padding="14,10"
                                            Margin="0,0,0,8" BorderThickness="2" BorderBrush="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Visibility="{Binding SelectorVisibility}" IsChecked="{Binding InProfile, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggleProfile}" Click="ProfileVoice_Click"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding GraillonHint}" Visibility="{Binding GraillonVisibility}"
                                                           Foreground="#C9A46A" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding GainText}" Visibility="{Binding GainVisibility}"
                                                           Foreground="{StaticResource FgDim}" FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Grid Grid.Column="2" Visibility="{Binding ControlsVisibility}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Umschalten" Foreground="{StaticResource FgDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                                <Button Grid.Column="1" Content="{Binding HotkeyText}" Click="Hotkey_Click" MinWidth="150" Padding="10,4" Margin="0,0,4,4"
                                                        ToolTip="Klicken und Tastenkombination drücken. Entf = löschen, Esc = abbrechen."/>
                                                <Button Grid.Column="2" Content="✕" Click="ClearHotkey_Click" Padding="8,4" Margin="0,0,0,4" ToolTip="Shortcut entfernen"/>
                                                <TextBlock Grid.Row="1" Text="Halten" Foreground="{StaticResource FgDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Row="1" Grid.Column="1" Content="{Binding HoldText}" Click="HoldKey_Click" MinWidth="150" Padding="10,4" Margin="0,0,4,0"
                                                        ToolTip="Solange diese Taste gedrückt ist, ist die Stimme aktiv – beim Loslassen geht es zurück. Ideal: Ziffernblock oder F-Tasten."/>
                                                <Button Grid.Row="1" Grid.Column="2" Content="✕" Click="ClearHold_Click" Padding="8,4" ToolTip="Halte-Taste entfernen"/>
                                            </Grid>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Visibility="{Binding ControlsVisibility}">
                                                <Button Content="Aktivieren" Click="Activate_Click" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Click="EditVoice_Click" Padding="7,4" Margin="0,0,3,0"
                                                            AutomationProperties.Name="Stimme bearbeiten"
                                                            ToolTip="Name, Beschreibung, Graillon-Hinweis und Lautstärke bearbeiten"/>
                                                    <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Click="CopyVoice_Click" Padding="7,4" Margin="0,0,3,0"
                                                            AutomationProperties.Name="Stimme kopieren"
                                                            ToolTip="Kopieren – als Vorlage für eine neue Stimme"/>
                                                    <Button Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" Click="ExportVoice_Click" Padding="7,4" Margin="0,0,3,0"
                                                            AutomationProperties.Name="Stimme exportieren"
                                                            ToolTip="Exportieren – als Datei speichern, z. B. zum Weitergeben"/>
                                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="DeleteVoice_Click" Padding="7,4"
                                                            Visibility="{Binding DeleteVisibility}" ToolTip="Stimme löschen"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActive}"/>
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ===== Soundboard ===== -->
            <TabItem Header="Soundboard">
                <DockPanel AllowDrop="True" Drop="Sounds_Drop" DragOver="Sounds_DragOver" Background="Transparent">
                    <Border DockPanel.Dock="Top" Padding="20,12,20,6">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="■  Alle stoppen" Command="{x:Static local:AppCommands.StopSounds}" Padding="12,5" Margin="0,0,6,8"
                                        ToolTip="Alle laufenden Sounds sofort beenden (Strg+.)"/>
                                <Button Content="+ Sounds hinzufügen …" Command="{x:Static local:AppCommands.AddSounds}" Padding="10,5" Margin="0,0,6,8"
                                        ToolTip="Audiodateien auswählen (Strg+Umschalt+O) – oder einfach hierher ziehen"/>
                                <Button Content="Sound-Ordner" Click="OpenSoundFolder_Click" Padding="10,5" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Lautstärke für andere" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <Slider x:Name="SoundVolumeSlider" Width="180" Minimum="0" Maximum="2" VerticalAlignment="Center" Margin="0,0,6,8"
                                        ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Lautstärke für andere"
                                        ToolTip="Bis 200 %: über 100 % wird verstärkt – ein Begrenzer verhindert, dass es übersteuert. Kommt im Sprachchat nichts an, hier hochdrehen."/>
                                <TextBlock Text="{Binding Value, ElementName=SoundVolumeSlider, StringFormat={}{0:P0}}" Width="42" VerticalAlignment="Center" Margin="0,0,18,8"/>
                                <CheckBox x:Name="SoundMonitorCheck" Content="Selbst mithören" Click="SoundMonitor_Click" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <Slider x:Name="SoundMonitorSlider" Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,6,8"
                                        ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Lautstärke zum Mithören"
                                        IsEnabled="{Binding IsChecked, ElementName=SoundMonitorCheck}"/>
                                <TextBlock Text="{Binding Value, ElementName=SoundMonitorSlider, StringFormat={}{0:P0}}" Width="42" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="SoundNormalizeCheck" Content="Lautstärke angleichen" Click="SoundNormalize_Click" VerticalAlignment="Center" Margin="0,0,18,8"
                                          ToolTip="Bringt jeden Sound automatisch auf volle Lautstärke – leise Dateien gehen im Sprachchat sonst unter."/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="PttLatchToggle" Content="Dauersenden: aus" Click="PttLatchToggle_Click" Padding="12,4" MinWidth="150" VerticalAlignment="Center" Margin="0,0,12,8"
                                        AutomationProperties.AutomationId="PttLatchToggle"
                                        ToolTip="Hält die Sprachtaste des Spiels dauerhaft gedrückt – du sendest dann ständig wie mit offenem Mikrofon. Nochmal = wieder Push-to-Talk. Die Notfall-Taste schaltet es auch aus."/>
                                <TextBlock x:Name="PttSummary" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,10,8" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="PttSummary"/>
                                <Button Content="Sprachtaste einstellen …" Click="OpenPttSettings_Click" Padding="10,4" VerticalAlignment="Center" Margin="0,0,0,8"
                                        ToolTip="Einstellungen → Sprachtaste im Spiel: welche Taste die App drückt und mit welcher Taste du Dauersenden umschaltest"/>
                            </WrapPanel>
                            <TextBlock x:Name="SoundHint" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                       Text="Audiodateien (wav, mp3, m4a, flac …) einfach hierher ziehen. Mit „Durch Stimmeffekt“ klingt ein Sound wie deine Stimme – unter der Maske also auch gedämpft. Ohne Haken hören die anderen ihn unverändert."/>
                            <TextBlock x:Name="SoundError" Foreground="#E5807A" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
                        <ItemsControl x:Name="SoundList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,10" Margin="0,0,8,8" Width="220">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Click="RenameSound_Click" Padding="7,4" Margin="0,0,3,0"
                                                            ToolTip="Sound umbenennen" AutomationProperties.Name="Sound umbenennen"/>
                                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="DeleteSound_Click" Padding="7,4"
                                                            ToolTip="Sound löschen (in den Papierkorb)" AutomationProperties.Name="Sound löschen"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" ToolTip="{Binding FileName}"/>
                                            </DockPanel>
                                            <Button Content="{Binding PlayText}" ToolTip="{Binding PlayTooltip}" Click="PlaySound_Click" Margin="0,0,0,6"
                                                    AutomationProperties.Name="{Binding PlayText}"/>
                                            <DockPanel Visibility="{Binding ProgressVisibility}" Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource FgDim}" FontSize="11"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="SoundTime"/>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" VerticalAlignment="Center"
                                                             Background="{StaticResource Line}" Foreground="{StaticResource Accent}" BorderThickness="0"
                                                             AutomationProperties.Name="Fortschritt"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Wiederholen" Foreground="{StaticResource FgDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox ItemsSource="{x:Static local:SoundItem.RepeatChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Repeat, Mode=TwoWay}" SelectionChanged="SoundRepeat_Changed"
                                                          AutomationProperties.Name="Wiederholen"
                                                          ToolTip="Einmal, mehrmals hintereinander oder endlos. Läuft der Sound, stoppt ihn derselbe Shortcut (oder ein zweiter Klick)."/>
                                            </DockPanel>
                                            <CheckBox Content="Durch Stimmeffekt" IsChecked="{Binding ThroughEffect, Mode=TwoWay}" Click="SoundEffect_Click"
                                                      Margin="0,0,0,6" ToolTip="An: Der Sound bekommt denselben Effekt wie deine Stimme. Aus: Die anderen hören ihn unverändert."/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Click="ClearSoundHotkey_Click" Padding="8,4" Margin="4,0,0,0" ToolTip="Shortcut entfernen"/>
                                                <Button Content="{Binding HotkeyText}" Click="SoundHotkey_Click" Padding="8,4"
                                                        ToolTip="Klicken und Tastenkombination drücken. Entf = löschen, Esc = abbrechen."/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
