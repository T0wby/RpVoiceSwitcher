<Window x:Class="RpVoiceSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RP Voice Switcher" Width="680" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <!-- Kopf -->
        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,8">
            <TextBlock Text="RP Voice Switcher" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource FgDim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Fuß: Optionen -->
        <Border DockPanel.Dock="Bottom" Background="#222227" Padding="20,12" BorderBrush="#33333A" BorderThickness="0,1,0,0">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="SoundCheck" Content="Ton beim Umschalten" Click="Option_Changed"/>
                    <CheckBox x:Name="OverlayCheck" Content="Einblendung beim Wechsel" Click="Option_Changed"/>
                    <CheckBox x:Name="TrayCheck" Content="Schließen = in den Tray" Click="Option_Changed"/>
                    <CheckBox x:Name="AutostartCheck" Content="Mit Windows starten" Click="Autostart_Changed"/>
                    <Button Content="Shortcuts zurücksetzen" Click="ResetHotkeys_Click" Padding="10,3" Margin="0,0,0,6"
                            ToolTip="Alle Shortcuts löschen oder die Standardbelegung Strg+Alt+0–9 wiederherstellen"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="StatusCheck" Content="Status-Anzeige auf dem Bildschirm" Click="StatusOverlay_Changed"
                              VerticalAlignment="Center"
                              ToolTip="Zeigt dauerhaft an, welche Stimme gerade aktiv ist"/>
                    <Button x:Name="MoveStatusButton" Content="Position anpassen" Click="MoveStatus_Click" Padding="10,3" Margin="0,0,8,6"
                            ToolTip="Anzeige mit der Maus verschieben. Doppelklick auf die Anzeige oder 'Fertig' zum Speichern."/>
                    <Button Content="Position zurücksetzen" Click="ResetStatusPosition_Click" Padding="10,3" Margin="0,0,0,6"/>
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Zielgerät:" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="EAPO-Editor" Click="OpenEditor_Click" Margin="8,0,0,0"
                            ToolTip="Equalizer-APO-Editor öffnen, z. B. um Graillon in eine Stimme einzubauen"/>
                    <Button DockPanel.Dock="Right" Content="Neu laden" Click="Reload_Click" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Stimmen-Ordner" Click="OpenFolder_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="DeviceBox" Background="#2C2C33" Foreground="{StaticResource Fg}" BorderBrush="#44444C"
                             Padding="6,4" VerticalContentAlignment="Center" LostFocus="DeviceBox_LostFocus"
                             ToolTip="Gerät, auf das die Stimmen wirken (wie in Windows angezeigt), z. B. CABLE Output"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Stimmenliste -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
            <ItemsControl x:Name="VoiceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource Card}" CornerRadius="8" Padding="14,10"
                                Margin="0,0,0,8" BorderThickness="2" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding GraillonHint}" Visibility="{Binding GraillonVisibility}"
                                               Foreground="#C9A46A" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding HotkeyText}" Click="Hotkey_Click" MinWidth="150"
                                        Margin="0,0,4,0" VerticalAlignment="Center"
                                        ToolTip="Klicken und neue Tastenkombination drücken. Entf = löschen, Esc = abbrechen."/>
                                <Button Grid.Column="2" Content="✕" Click="ClearHotkey_Click" Padding="9,6"
                                        Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Shortcut entfernen"/>
                                <Button Grid.Column="3" Content="Aktivieren" Click="Activate_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActive}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
