<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RpVoiceSwitcher</AssemblyName>
    <RootNamespace>RpVoiceSwitcher</RootNamespace>
    <Version>1.8.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>RP Voice Switcher</Product>
    <Description>Stimmen, Charaktere und Soundboard fuer Roleplay</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Voices\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
